# =============================================================================
# ARIO — copy to apps/web/.env.local and apps/landing/.env.local as needed
# Never commit real secrets. Never put service-role keys in NEXT_PUBLIC_* vars.
# =============================================================================

# Public site URLs (no trailing slash). Used for canonicals, invites, PWA.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001

# Supabase (anon key is public; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (generate with: npx web-push generate-vapid-keys)
# Public key may be exposed to the browser; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# WebRTC — public STUN is fine; TURN credentials must stay server-side
# Example TURN_URLS: turn:turn.example.com:3478,turns:turn.example.com:443
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional SMTP (invite emails). App works without this.
SMTP_URL=

# Optional future OTP/SMS provider (leave empty — login does not require SMS)
OTP_PROVIDER=
OTP_API_KEY=

# Server-only secret for trusted push fan-out (edge/DB webhook). Leave empty to disable internal dispatch.
PUSH_DISPATCH_SECRET=

# Server-only secret for cron endpoints (/api/cron/* and Edge Functions).
# Generate a long random string. Required before scheduling expire-stories / publish-scheduled.
CRON_SECRET=

# Cloudflare R2 (recommended production file storage — 10GB free).
# If unset, files fall back to Supabase Storage. Never put these in NEXT_PUBLIC_*.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ario
# Optional; defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
